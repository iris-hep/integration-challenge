name: "jet_network_batch"
platform: "onnxruntime_onnx"
max_batch_size: 0

input [
  {
    name: "jet_features"
    data_type: TYPE_FP32
    dims: [ -1, -1, 4 ]
  },
  {
    name: "jet_features_mask"
    data_type: TYPE_BOOL
    dims: [ -1, -1 ]
  },
  {
    name: "el_features"
    data_type: TYPE_FP32
    dims: [ -1, -1, 3 ]
  },
  {
    name: "el_features_mask"
    data_type: TYPE_BOOL
    dims: [ -1, -1 ]
  }
]

output [
  {
    name: "model2Batch_pmc"
    data_type: TYPE_FP32
    dims: [ -1 ]
  }
]